# Valori di QUESTA installazione. Copiare in .env (gitignorato) e valorizzare.
# Li usa ./apply-manual.sh per sostituire i segnaposto in k8s/manual/.
#
# Non finiscono nel repo di proposito: e' pubblico.

# Share SMB delle foto, nella forma //HOST-O-IP/NomeShare
NAS_SHARE=

# Hostname pubblico servito da Traefik, es. photovault.esempio.tld
PHOTOVAULT_HOST=
