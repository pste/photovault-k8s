# Modello. Copiare in secrets.yaml, valorizzare, poi ./encrypt.sh.
#
# TOKEN protegge le rotte /api/internal/* usate dai cron. E' l'unica regola di
# sicurezza dell'applicazione: tutto il resto e' aperto, perche' photovault
# gira solo in LAN. Va generato lungo e casuale, per esempio con
#   openssl rand -hex 32
apiVersion: v1
kind: Secret
metadata:
  name: photovault-secrets
  namespace: photovault
stringData:
  TOKEN: ""
