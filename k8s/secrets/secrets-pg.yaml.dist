# Modello. Copiare in secrets-pg.yaml, valorizzare, poi ./encrypt.sh.
#
# Le stesse tre variabili le usano il Deployment di Postgres (per creare il
# database al primo avvio), l'API (per collegarsi) e le migrations di
# photovault-db (in port-forward).
apiVersion: v1
kind: Secret
metadata:
  name: photovault-pgcreds
  namespace: photovault
stringData:
  PGDATABASE: ""
  PGUSER: ""
  PGPASSWORD: ""
