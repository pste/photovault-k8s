# Modello. Copiare in secrets.yaml, valorizzare, poi ./encrypt.sh.
#
# TOKEN protegge le rotte /api/internal/* usate dai cron.
# SESSION_SECRET firma il cookie di sessione degli utenti: almeno 32 caratteri,
# e cambiarlo slogga tutti.
# Entrambi vanno generati lunghi e casuali, per esempio con
#   openssl rand -hex 32
apiVersion: v1
kind: Secret
metadata:
  name: photovault-secrets
  namespace: photovault
stringData:
  TOKEN: ""
  SESSION_SECRET: ""
